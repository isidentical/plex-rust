+
+// Whether the reader of the stream gets to pts through packets that are
+// queued already and without meeting a keyframe. A decoder that goes on
+// from where it is then has less to decode than one that restarts at the
+// keyframe before pts, which it is already past.
+bool demux_reads_on_to(struct demuxer *demuxer, struct sh_stream *sh, double pts)
+{
+    struct demux_internal *in = demuxer->in;
+    mp_assert(demuxer == in->d_user);
+
+    struct demux_stream *ds = sh->ds;
+    if (!ds || ds->in != in || pts == MP_NOPTS_VALUE)
+        return false;
+
+    bool reaches = false;
+    mp_mutex_lock(&in->lock);
+    pts = MP_ADD_PTS(pts, -in->ts_offset);
+    if (ds->selected && !in->seeking && !in->back_demuxing) {
+        for (struct demux_packet *dp = ds->reader_head; dp; dp = dp->next) {
+            if (dp->keyframe)
+                break;
+            if (dp->pts != MP_NOPTS_VALUE && dp->pts >= pts) {
+                reaches = true;
+                break;
+            }
+        }
+    }
+    mp_mutex_unlock(&in->lock);
+    return reaches;
 }
 
