+
+// How far ahead of the picture on screen a decode-on seek must go. What is
+// decoded and not shown or heard yet is dropped by the seek and must all
+// lie before the target: up to 10 video frames and about half a second of
+// audio in the output's buffers.
+#define DECODE_ON_MIN_DISTANCE 1.0
+
+// Whether an exact seek to seek_pts can leave the decoders alone and decode
+// on from where playback is, dropping frames up to the target.
+//
+// A seek resets the decoders and restarts them at the keyframe before the
+// target. For a short jump forward that keyframe usually lies behind the
+// current position, so the decoder decodes again what it just decoded: with
+// a keyframe every 10 seconds, 5 seconds of video on average for a jump of
+// 3. If there is no keyframe between the current position and the target,
+// going on from the current position gets to the same frame with less work,
+// and with the same picture, since it is what plain playback would decode.
+//
+// Everything else about the seek stays: the outputs are reset, frames before
+// the target are dropped and the audio syncs to the first video frame.
+static bool can_decode_on(struct MPContext *mpctx, double seek_pts)
+{
+    struct vo_chain *vo_c = mpctx->vo_chain;
+    struct ao_chain *ao_c = mpctx->ao_chain;
+
+    if (mpctx->opts->play_dir < 0 || mpctx->play_dir < 0)
+        return false;
+    // Playback must be running: mid-seek the decoders are somewhere else.
+    if (!mpctx->restart_complete || !vo_c || vo_c->is_sparse || !vo_c->track ||
+        !vo_c->track->dec || mpctx->video_status != STATUS_PLAYING)
+        return false;
+    if (ao_c && (!ao_c->track || !ao_c->track->dec ||
+                 mpctx->audio_status != STATUS_PLAYING))
+        return false;
+    // External files have demuxers of their own that a seek must move.
+    for (int n = 0; n < mpctx->num_tracks; n++) {
+        struct track *track = mpctx->tracks[n];
+        if (track->selected && track->demuxer != mpctx->demuxer)
+            return false;
+    }
+    if (mpctx->video_pts == MP_NOPTS_VALUE ||
+        seek_pts < mpctx->video_pts + DECODE_ON_MIN_DISTANCE)
+        return false;
+    return demux_reads_on_to(mpctx->demuxer, vo_c->track->stream, seek_pts);
+}
