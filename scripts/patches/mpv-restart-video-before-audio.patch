+// Pull AOs: how long audio takes from being read by the device until it is
+// heard, in seconds. 0 for push AOs and before the device has read anything.
+double ao_get_latency(struct ao *ao)
+{
+    struct buffer_state *p = ao->buffer_state;
+
+    mp_mutex_lock(&p->lock);
+    double latency = MP_TIME_NS_TO_S(p->latency_ns);
+    mp_mutex_unlock(&p->lock);
+    return latency;
+}
+
+// Pull AOs: until the device reads for the first time after ao_reset(),
+// end_time_ns is 0 and ao_get_delay() leaves the device's latency out. The
+// player would then time video as if the queued audio were heard at once.
+// Assume the latency of the last read until the next one replaces it.
+// Call with the lock held, when the device is about to start reading.
+static void expect_latency(struct ao *ao)
+{
+    struct buffer_state *p = ao->buffer_state;
+
+    if (!ao->driver->write && !p->end_time_ns)
+        p->end_time_ns = mp_time_ns() + p->latency_ns;
+}
+
 // Fully stop playback; clear buffers, including queue.
 void ao_reset(struct ao *ao)
 {
