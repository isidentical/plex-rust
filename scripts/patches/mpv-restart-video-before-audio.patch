+// After a seek the video restarts at once and the audio joins it in sync.
+//
+// Audio handed to the AO is heard one AO latency later (171 ms on AirPods
+// Pro). Unpatched, the audio restarts at the pts of the first video frame,
+// and since video is timed against the audio that is heard, the second
+// frame waits until that audio has come out: the picture stands still for
+// the latency after every seek. Instead, start the audio at the pts the
+// video will have reached when it is first heard. The sound comes back at
+// the same moment as before, the picture does not wait for it.
+//
+// Returns how much audio to leave out, in seconds of the file. Only seeks
+// with video are changed. 0 means unpatched behavior: no seek, a push AO,
+// or an AO that has not played yet and so has no known latency.
+static double get_start_skip(struct MPContext *mpctx)
+{
+    bool with_video = mpctx->vo_chain && !mpctx->vo_chain->is_sparse &&
+                      mpctx->video_status != STATUS_EOF;
+    if (!mpctx->current_seek.type || !mpctx->ao || !with_video)
+        return 0;
+    return ao_get_latency(mpctx->ao) * mpctx->audio_speed;
+}
+
 // Look whether audio can be started yet - if audio has to start some time
 // after video.
 // Caller needs to ensure mpctx->restart_complete is OK
@@ -876,6 +901,10 @@
     }
 
     MP_VERBOSE(mpctx, "starting audio playback\n");
+    // delay is how far the written audio is ahead of the video. It was
+    // counted from the first sample, which is start_skip past the video.
+    mpctx->delay += ao_c->start_skip;
+    ao_c->start_skip = 0;
     ao_c->delaying_audio_start = false;
     ao_start(ao_c->ao);
     mpctx->audio_status = STATUS_PLAYING;
@@ -920,6 +949,10 @@
